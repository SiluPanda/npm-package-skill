{
  "name": "npm-package-skill",
  "version": "0.1.0",
  "description": "A Claude Code skill that scaffolds production-grade npm packages with TypeScript, dual ESM/CJS output, testing, linting, CI/CD, and publishing configuration.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "npm-package-skill": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "changeset": "changeset",
    "release": "changeset publish",
    "version": "changeset version",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "claude-code",
    "skill",
    "npm",
    "package",
    "scaffold",
    "typescript",
    "template",
    "boilerplate",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiluPanda/npm-package-skill.git"
  },
  "homepage": "https://github.com/SiluPanda/npm-package-skill#readme",
  "bugs": {
    "url": "https://github.com/SiluPanda/npm-package-skill/issues"
  },
  "author": "SiluPanda",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
